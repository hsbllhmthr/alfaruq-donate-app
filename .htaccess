# ========================================
# .htaccess - Alfaruq Donate App Security
# ========================================

# Aktifkan RewriteEngine
Options -Indexes
DirectoryIndex index.html index.php login.php
RewriteEngine On


# --- Blokir Akses ke File Sensitif ---
# Blokir check_db.php dan migrate.php dari akses publik
<FilesMatch "^(check_db|migrate|db-connect)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blokir akses ke file .json, .sql, .env, .git
<FilesMatch "\.(sql|json|env|md|lock|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# --- Keamanan Header ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Redirect HTTP ke HTTPS (Aman untuk Nginx Reverse Proxy) ---
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>


# --- Cache Static Assets ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# --- Kompresi Gzip ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
