{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/(get-.*\\.php|save-.*\\.php|migrate\\.php|db-connect\\.php)",
      "dest": "/api/index.php"
    },
    {
      "src": "/admin/(.*\\.php|)",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    }
  ]
}

