{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/index.php" },
    { "source": "/admin/", "destination": "/api/index.php" },
    { "source": "/admin/:path*.php", "destination": "/api/index.php" },
    { "source": "/:file.php", "destination": "/api/index.php" }
  ]
}
